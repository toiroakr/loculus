pkgtype(kind: "foreign_library")

options(
  link: {
    "js": {
      "exports": [ "compile_schema", "validate", "decimal" ],
      "format": "esm",
    },
    "wasm-gc": {
      "exports": [ "compile_schema", "validate", "decimal" ],
      "use-js-builtin-string": true,
    },
  },
  targets: { "host_js.mbt": [ "js" ], "host_wasm.mbt": [ "wasm-gc" ] },
)
