{
  "name": "@loculus/infer",
  "version": "0.0.0",
  "description": "Extract input/output types from Loculus schemas as TypeScript source",
  "keywords": [
    "loculus",
    "schema",
    "type-extraction",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toiroakr/loculus.git",
    "directory": "packages/infer"
  },
  "bin": {
    "loculus-infer": "./bin/loculus-infer.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "tinyglobby": "^0.2.15",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "knip": "6.39.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "tsdown": "^0.23.1"
  },
  "peerDependencies": {
    "loculus": "workspace:^"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
