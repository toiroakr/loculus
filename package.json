{
  "name": "loculus",
  "version": "0.2.5",
  "description": "Flat schemas for string inputs",
  "license": "MIT",
  "homepage": "https://toiroakr.github.io/loculus/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toiroakr/loculus.git"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@11.28.5",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only --ignore-scripts",
    "release": "changeset publish",
    "build": "tsdown && pnpm --filter @loculus/rolldown build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.* && pnpm check:tree-shaking && pnpm check:packages",
    "docs:build": "pnpm build && node examples/react-hook-form/build.mjs && node docs/compatibility/audit.mjs && bun docs/compatibility/audit.mjs docs/generated/compatibility/bun.json && node docs/compatibility/render.mjs && node docs/build-home.mjs",
    "docs:preview": "node docs/build-preview.mjs",
    "docs:check": "node docs/check-home.mjs",
    "demo:rhf": "pnpm build && node examples/react-hook-form/build.mjs && node examples/react-hook-form/serve.mjs",
    "test:rhf": "pnpm build && tsc -p examples/react-hook-form/tsconfig.json && node examples/react-hook-form/build.mjs && playwright test --config examples/react-hook-form/playwright.config.ts",
    "prepublishOnly": "npm run build",
    "check:tree-shaking": "pnpm build && node bench/tree-shaking.mjs && node bench/tree-shaking-rolldown.mjs",
    "check:packages": "node test/packages.mjs",
    "bench:ci": "pnpm build && node bench/ci/run.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@hookform/resolvers": "^5.9.1",
    "@playwright/test": "^1.64.0",
    "@standard-schema/spec": "^1.0.0",
    "@twinkleplop/bash": "^0.1.7",
    "@twinkleplop/json": "^0.1.7",
    "@twinkleplop/theme-github": "^0.2.4",
    "@twinkleplop/typescript": "^0.1.7",
    "@types/node": "^25.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "entities": "^8.1.0",
    "esbuild": "^0.28.2",
    "pkg-pr-new": "0.0.91",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "rolldown": "^1.2.13",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "valibot": "^1.4.2",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
